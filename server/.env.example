# FinVanguard NBFC REST API Server Environment Variables
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nbfc_loan_db?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Base URL of deployed server (Optional, for document vault links)
SERVER_URL=https://your-app-name.onrender.com

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=884920-nbfc-finvanguard.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://your-app-name.onrender.com/api/auth/google/callback

# DigiLocker e-KYC Integration
DIGILOCKER_CLIENT_ID=finvanguard_nbfc_sandbox
DIGILOCKER_CLIENT_SECRET=digilocker_secret_2026
DIGILOCKER_REDIRECT_URI=https://your-app-name.onrender.com/digilocker/callback

# Twilio SMS API Configuration (Universal 2FA OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15017122661

# Google Cloud Storage Vault (Optional)
GCS_BUCKET_NAME=finvanguard-nbfc-loan-vault
GOOGLE_APPLICATION_CREDENTIALS=
